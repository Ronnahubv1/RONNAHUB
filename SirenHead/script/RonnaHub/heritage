----------------------------------------------------------------
local function isWoodenCrate(prompt)
    local parent = prompt.Parent
    if not parent then return false end
    
    local parentName = string.lower(parent.Name)
    local grandParentName = parent.Parent and string.lower(parent.Parent.Name) or ""
    
    if string.find(parentName, "shop") or string.find(parentName, "gun") or string.find(parentName, "weapon") or 
       string.find(grandParentName, "shop") or string.find(grandParentName, "gun") or string.find(grandParentName, "weapon") then
        return false
    end
    
    if string.find(parentName, "crate") or string.find(parentName, "box") or string.find(parentName, "chest") or string.find(parentName, "supply") or
       string.find(grandParentName, "crate") or string.find(grandParentName, "box") or string.find(grandParentName, "chest") then
        return true
    end
    
    return false
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if autofarmActive then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if not autofarmActive then break end

                    if prompt:IsA("ProximityPrompt") and isWoodenCrate(prompt) and prompt.Parent then
                        local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                        
                        if targetPart and targetPart.Parent then
                            local targetCFrame = targetPart.CFrame + Vector3.new(0, 3.5, 0)
                            
                            local startTime = tick()
                            while tick() - startTime < 0.35 and autofarmActive do
                                hrp.Velocity = Vector3.new(0, 0, 0)
                                hrp.CFrame = targetCFrame

                                if firetouchinterest and targetPart then
                                    firetouchinterest(hrp, targetPart, 0)
                                    firetouchinterest(hrp, targetPart, 1)
                                end

                                prompt.RequiresLineOfSight = false
                                prompt.MaxActivationDistance = 9999
                                prompt.HoldDuration = 0
                                fireproximityprompt(prompt)

                                task.wait(0.02)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

